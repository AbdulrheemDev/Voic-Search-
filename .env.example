APP_NAME="محرك البحث الصوتي - متجر تجريبي"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Aden
APP_URL=http://127.0.0.1:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# قاعدة بيانات المتجر المستضيف (MySQL 8.4 حسب الجدول 2.1 في الفصل الأول)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=voice_search_store
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# محرك البحث Meilisearch (خادم محلي على المنفذ 7700)
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=masterKey
SCOUT_PREFIX=
SCOUT_QUEUE=false

# إعداد المعالجة الافتراضي في الواجهة: a أو b أو c (الإعداد ج هو الإعداد النهائي للمحرك)
VOICE_SEARCH_SETTING=c
