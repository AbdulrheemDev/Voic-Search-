{
  "manifest_version": 3,
  "name": "مساعد البحث الصوتي الذكي للتسوق العربي | Voice Search",
  "version": "1.0.0",
  "description": "إضافة ذكية تتيح البحث الصوتي باللغة العربية واللهجات الدارجة في منصات التجارة الإلكترونية مع التطبيع والقاموس التجاري التلقائي.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "البحث الصوتي الذكي"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
